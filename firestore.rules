rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Має відповідати ADMIN_EMAIL у firebase-config.js
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@vidrobitka.internal';
    }

    // Налаштування кафедри/предмету/лімітів — читає будь-хто,
    // змінює лише адміністратор (через вхід за паролем в адмінпанелі).
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Реєстрації студентів — читає будь-хто (публічна статистика),
    // створювати може будь-хто (без входу в акаунт), але лише з
    // коректними обов'язковими полями. Редагувати/видаляти окремі
    // записи може лише адміністратор.
    match /registrations/{regId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(
          ['email','fullName','course','group','reasonType','absenceDate','topic','targetDate','createdAt']
        ) &&
        request.resource.data.email is string && request.resource.data.email.size() > 3 &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 &&
        request.resource.data.course is number &&
        request.resource.data.course >= 1 && request.resource.data.course <= 6 &&
        request.resource.data.group is string && request.resource.data.group.size() > 0 &&
        request.resource.data.reasonType in ['unexcused', 'excused'] &&
        request.resource.data.absenceDate is string &&
        request.resource.data.topic is string && request.resource.data.topic.size() > 0 &&
        request.resource.data.targetDate is string &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Лічильники квот на дату (неповажна/поважна причина).
    // Відкритий запис потрібен, щоб студенти могли реєструватися без
    // входу в акаунт — див. розділ 6 README.md "Обмеження безпеки".
    match /counters/{dateId} {
      allow read: if true;
      allow write: if true;
    }

    // Лічильники "скільки тем зареєстровано з однієї пошти на дату".
    match /emailCounters/{key} {
      allow read: if true;
      allow write: if true;
    }
  }
}
